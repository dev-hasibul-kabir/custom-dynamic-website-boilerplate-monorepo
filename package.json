{
  "name": "custom-dynamic-website-boilerplate-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "db:migrate:dev": "pnpm --filter @repo/api db:migrate:dev",
    "db:migrate:prod": "pnpm --filter @repo/api db:migrate:prod",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "dev:storage": "pnpm --filter @repo/storage dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "build": "turbo run build",
    "build:storage": "pnpm --filter @repo/storage build",
    "build:api": "pnpm --filter @repo/api build",
    "build:admin": "pnpm --filter @repo/admin build",
    "build:web": "pnpm --filter @repo/web build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:storage": "pnpm --filter @repo/storage clean",
    "clean:api": "pnpm --filter @repo/api clean",
    "clean:admin": "pnpm --filter @repo/admin clean",
    "clean:web": "pnpm --filter @repo/web clean",
    "test": "turbo run test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:monitor": "pm2 monit",
    "deploy:prod:pm2": "(pm2 delete ecosystem.config.js || true) && sleep 3 && pnpm install && sleep 3 && pnpm db:migrate:prod && sleep 3 && pnpm db:seed && sleep 3 && pnpm build && sleep 3 && pm2 start ecosystem.config.js"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "pm2": "^6.0.14",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "hono": ">=4.10.2",
      "glob": ">=10.5.0",
      "js-yaml": ">=4.1.1",
      "cookie": ">=0.7.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@prisma/client"
      ],
      "allowedVersions": {
        "@prisma/client": "7",
        "react": "18"
      }
    }
  }
}
