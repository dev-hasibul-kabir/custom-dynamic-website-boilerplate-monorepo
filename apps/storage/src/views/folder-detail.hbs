<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-lg shadow-md p-8 mb-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">
          <i class="fas fa-folder mr-2 text-blue-600"></i>{{folderName}}
        </h1>
        {{#if folder}}
        <p class="text-gray-600 mt-2">{{folder.fileCount}} file(s)</p>
        {{/if}}
      </div>
      <a href="/folders" class="text-blue-600 hover:text-blue-800">
        <i class="fas fa-arrow-left mr-2"></i>Back to Folders
      </a>
    </div>

    <!-- File Upload Section -->
    <div class="border-t pt-6 mt-6">
      <h2 class="text-xl font-semibold mb-4">
        <i class="fas fa-upload mr-2 text-green-600"></i>Upload File
      </h2>
      <form id="uploadForm" enctype="multipart/form-data" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">File</label>
            <input
              type="file"
              name="file"
              id="fileInput"
              class="w-full px-4 py-2 border rounded"
              required
            >
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Custom File Name (optional)</label>
            <input
              type="text"
              name="fileName"
              placeholder="Leave empty to use original name"
              class="w-full px-4 py-2 border rounded"
            >
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <label class="flex items-center">
            <input type="checkbox" name="isConvertToWebp" class="mr-2">
            <span class="text-sm text-gray-700">Convert to WebP (for images)</span>
          </label>
        </div>
        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition">
          <i class="fas fa-upload mr-2"></i>Upload File
        </button>
      </form>
    </div>
  </div>

  <!-- Files List -->
  <div class="bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-semibold mb-6">
      <i class="fas fa-file mr-2 text-blue-600"></i>Files
    </h2>

    {{#if files.length}}
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              File Name
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          {{#each files}}
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <a href="{{this.url}}" target="_blank" class="text-blue-600 hover:text-blue-800">
                <i class="fas fa-file mr-2"></i>{{this.name}}
              </a>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <a href="{{this.url}}" target="_blank" class="text-blue-600 hover:text-blue-900 mr-3">
                <i class="fas fa-eye"></i> View
              </a>
              <button onclick="deleteFile('{{../folderName}}', '{{this.name}}')" class="text-red-600 hover:text-red-900">
                <i class="fas fa-trash"></i> Delete
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="text-center py-12 text-gray-500">
      <i class="fas fa-file text-5xl mb-4"></i>
      <p>No files in this folder yet. Upload your first file!</p>
    </div>
    {{/if}}
  </div>
</div>

<script>
document.getElementById('uploadForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const formData = new FormData(e.target);
  formData.append('folderName', '{{folderName}}');

  const fileInput = document.getElementById('fileInput');
  if (!fileInput.files[0]) {
    alert('Please select a file');
    return;
  }

  formData.append('file', fileInput.files[0]);

  try {
    const response = await axios.post('/v1/content/files', formData, {
      headers: {
        'Content-Type': 'multipart/form-data',
      },
    });

    if (response.data.statusCode === 200) {
      window.location.reload();
    }
  } catch (error) {
    alert(error.response?.data?.message || 'Failed to upload file');
  }
});

async function deleteFile(folderName, fileName) {
  if (!confirm(`Are you sure you want to delete "${fileName}"?`)) {
    return;
  }

  try {
    const response = await axios.delete(`/v1/content/folders/${folderName}/files/${fileName}`);
    if (response.data.statusCode === 200) {
      window.location.reload();
    }
  } catch (error) {
    alert(error.response?.data?.message || 'Failed to delete file');
  }
}
</script>

