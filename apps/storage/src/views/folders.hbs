<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold text-gray-800">
        <i class="fas fa-folder mr-2 text-blue-600"></i>Folders
      </h1>
      <button onclick="showCreateFolderModal()" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
        <i class="fas fa-plus mr-2"></i>Create Folder
      </button>
    </div>

    {{#if folders.length}}
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Folder Name
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          {{#each folders}}
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <a href="/folders/{{this.name}}" class="text-blue-600 hover:text-blue-800 font-medium">
                <i class="fas fa-folder mr-2"></i>{{this.name}}
              </a>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <button onclick="editFolder('{{this.name}}')" class="text-blue-600 hover:text-blue-900 mr-3">
                <i class="fas fa-edit"></i> Edit
              </button>
              <button onclick="deleteFolder('{{this.name}}')" class="text-red-600 hover:text-red-900">
                <i class="fas fa-trash"></i> Delete
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="text-center py-12 text-gray-500">
      <i class="fas fa-folder-open text-5xl mb-4"></i>
      <p>No folders found. Create your first folder!</p>
    </div>
    {{/if}}
  </div>
</div>

<!-- Create/Edit Folder Modal -->
<div id="folderModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
    <h3 id="modalTitle" class="text-xl font-bold mb-4">Create New Folder</h3>
    <form id="folderForm" onsubmit="submitFolderForm(event)">
      <input
        type="text"
        name="folderName"
        id="folderNameInput"
        placeholder="Folder name"
        class="w-full px-4 py-2 border rounded mb-4"
        required
      >
      <input type="hidden" id="oldFolderName" name="oldFolderName">
      <div class="flex justify-end space-x-3">
        <button type="button" onclick="hideFolderModal()" class="px-4 py-2 border rounded hover:bg-gray-100">
          Cancel
        </button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
          Save
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function showCreateFolderModal() {
  document.getElementById('modalTitle').textContent = 'Create New Folder';
  document.getElementById('folderNameInput').value = '';
  document.getElementById('oldFolderName').value = '';
  document.getElementById('folderModal').classList.remove('hidden');
  document.getElementById('folderModal').classList.add('flex');
}

function editFolder(folderName) {
  document.getElementById('modalTitle').textContent = 'Edit Folder';
  document.getElementById('folderNameInput').value = folderName;
  document.getElementById('oldFolderName').value = folderName;
  document.getElementById('folderModal').classList.remove('hidden');
  document.getElementById('folderModal').classList.add('flex');
}

function hideFolderModal() {
  document.getElementById('folderModal').classList.add('hidden');
  document.getElementById('folderModal').classList.remove('flex');
}

async function submitFolderForm(event) {
  event.preventDefault();
  const formData = new FormData(event.target);
  const folderName = formData.get('folderName');
  const oldFolderName = formData.get('oldFolderName');

  try {
    if (oldFolderName) {
      // Update
      const response = await axios.put(`/v1/content/folders/${oldFolderName}`, { folderName });
      if (response.data.statusCode === 200) {
        window.location.reload();
      }
    } else {
      // Create
      const response = await axios.post('/v1/content/folders', { folderName });
      if (response.data.statusCode === 201) {
        window.location.reload();
      }
    }
  } catch (error) {
    alert(error.response?.data?.message || 'Operation failed');
  }
}

async function deleteFolder(folderName) {
  if (!confirm(`Are you sure you want to delete folder "${folderName}"?`)) {
    return;
  }

  try {
    const response = await axios.delete(`/v1/content/folders/${folderName}`);
    if (response.data.statusCode === 200) {
      window.location.reload();
    }
  } catch (error) {
    alert(error.response?.data?.message || 'Failed to delete folder');
  }
}
</script>

